{
 "_about": "Overrides for jobatlas/config.py DEFAULTS. Copy to <data>/config.json and keep only what you change.",
 "poll": {"interval_hours": 3.0, "workers": 12},
 "export": {"hours": 72, "min_tier": "fair"},
 "api": {"host": "127.0.0.1", "port": 8804},
 "ledger": {"path": ""},
 "alerts": {
  "enabled": false,
  "channel": "discord_webhook",
  "env_file": "/etc/jobatlas/alerts.env",
  "min_score": 92,
  "daily_cap": 6,
  "quiet_start": 22,
  "quiet_end": 8,
  "tz": "America/New_York"
 },
 "profiles": {
  "_about": "Optional: more people scored from the same crawl. Copy examples/profile.partner.example.json to <data>/profile-partner.json.",
  "partner": {
   "file": "profile-partner.json",
   "claim_tier": "good",
   "main_keeps_fields": ["tech_support", "it_support"],
   "ledger": {"path": ""},
   "alerts": {"enabled": false, "channel": "discord_webhook", "env_file": "/etc/jobatlas/partner.env", "label": "New job for you", "style": "plain"}
  }
 },
 "duel": {
  "_about": "Optional: a model decides who of the two gets a job that fits both (jobatlas duel run, from a timer). Off until enabled.",
  "enabled": false,
  "with": "partner",
  "margin": 0.10,
  "command": ["claude", "-p", "--model", "sonnet", "--output-format", "json", "--tools", "", "--no-session-persistence"],
  "candidates": {
   "main": {"label": "Sam", "resumes": {"Support": "resume-support.pdf", "Community": "resume-community.pdf"},
            "facts": ["No bachelor's degree", "Remote, or on-site downtown only (doesn't drive)"]},
   "partner": {"label": "Alex", "resumes": {"General": "resume-partner.pdf"}, "facts_file": "partner-notes.md"}
  }
 }
}
